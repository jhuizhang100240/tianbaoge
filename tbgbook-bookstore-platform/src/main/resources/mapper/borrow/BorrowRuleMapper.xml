<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tbgbook.bookstore.borrow.mapper.BorrowRuleMapper">

    <resultMap type="BorrowRule" id="BorrowRuleResult">
        <result property="ruleId"                  column="rule_id"                  />
        <result property="storeId"                 column="store_id"                 />
        <result property="finePerDay"              column="fine_per_day"             />
        <result property="fineMaxRate"             column="fine_max_rate"            />
        <result property="compensateRate"          column="compensate_rate"          />
        <result property="renewTimes"              column="renew_times"              />
        <result property="renewDays"               column="renew_days"               />
        <result property="reserveHoldDays"         column="reserve_hold_days"        />
        <result property="remindDaysBefore"        column="remind_days_before"       />
        <result property="overdueRemindInterval"   column="overdue_remind_interval"  />
        <result property="blockOverdueBorrow"      column="block_overdue_borrow"     />
        <result property="status"                  column="status"                   />
        <result property="createBy"                column="create_by"                />
        <result property="createTime"              column="create_time"              />
        <result property="updateBy"                column="update_by"                />
        <result property="updateTime"              column="update_time"              />
        <result property="remark"                  column="remark"                   />
    </resultMap>

    <select id="selectBorrowRuleList" parameterType="BorrowRule" resultMap="BorrowRuleResult">
        select r.rule_id, r.store_id, r.fine_per_day, r.fine_max_rate, r.compensate_rate,
               r.renew_times, r.renew_days, r.reserve_hold_days, r.remind_days_before,
               r.overdue_remind_interval, r.block_overdue_borrow, r.status,
               r.create_by, r.create_time, r.update_by, r.update_time, r.remark
        from biz_borrow_rule r
        <where>
            <if test="status != null and status != ''">
                and r.status = #{status}
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                and r.create_time &gt;= #{params.beginTime}
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                and r.create_time &lt;= #{params.endTime}
            </if>
        </where>
        order by r.rule_id
    </select>
</mapper>
