<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tbgbook.bookstore.borrow.mapper.PenaltyMapper">

    <resultMap type="Penalty" id="PenaltyResult">
        <result property="penaltyId"     column="penalty_id"     />
        <result property="storeId"       column="store_id"       />
        <result property="penaltyNo"     column="penalty_no"     />
        <result property="memberId"      column="member_id"      />
        <result property="borrowId"      column="borrow_id"      />
        <result property="bookId"        column="book_id"        />
        <result property="penaltyType"   column="penalty_type"   />
        <result property="amount"        column="amount"         />
        <result property="calcBase"      column="calc_base"      />
        <result property="calcDetail"    column="calc_detail"    />
        <result property="deductDeposit" column="deduct_deposit" />
        <result property="payStatus"     column="pay_status"     />
        <result property="payTime"       column="pay_time"       />
        <result property="payMethod"     column="pay_method"     />
        <result property="auditBy"       column="audit_by"       />
        <result property="auditTime"     column="audit_time"     />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"        column="remark"         />
    </resultMap>

    <select id="selectPenaltyList" parameterType="Penalty" resultMap="PenaltyResult">
        select p.penalty_id, p.store_id, p.penalty_no, p.member_id, p.borrow_id, p.book_id,
               p.penalty_type, p.amount, p.calc_base, p.calc_detail, p.deduct_deposit,
               p.pay_status, p.pay_time, p.pay_method, p.audit_by, p.audit_time,
               p.create_by, p.create_time, p.update_by, p.update_time, p.remark
        from biz_penalty p
        <where>
            <if test="penaltyNo != null and penaltyNo != ''">
                and p.penalty_no = #{penaltyNo}
            </if>
            <if test="memberId != null">
                and p.member_id = #{memberId}
            </if>
            <if test="borrowId != null">
                and p.borrow_id = #{borrowId}
            </if>
            <if test="bookId != null">
                and p.book_id = #{bookId}
            </if>
            <if test="penaltyType != null">
                and p.penalty_type = #{penaltyType}
            </if>
            <if test="payStatus != null">
                and p.pay_status = #{payStatus}
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                and p.create_time &gt;= #{params.beginTime}
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                and p.create_time &lt;= #{params.endTime}
            </if>
        </where>
        order by p.penalty_id desc
    </select>

    <select id="selectUnpaidTotal" resultType="java.math.BigDecimal">
        select ifnull(sum(p.amount - p.deduct_deposit), 0.00)
        from biz_penalty p
        where p.member_id = #{memberId}
          and p.pay_status in (1, 3)
    </select>
</mapper>
