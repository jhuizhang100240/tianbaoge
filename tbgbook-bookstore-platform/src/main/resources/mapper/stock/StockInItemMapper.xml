<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  采购入库单明细 Mapper XML
  ⚠️ 只写 MP 覆盖不了的（后端 CLAUDE.md §五）；不写 SELECT *；一律 #{}
  ⚠️ isbn / title 是本表的**冗余列**（不是 JOIN 来的）—— 单据要能脱离图书表独立呈现：
     图书改名后，历史单据应显示当时的书名。
-->
<mapper namespace="com.tbgbook.bookstore.stock.mapper.StockInItemMapper">

    <resultMap type="StockInItem" id="StockInItemResult">
        <result property="itemId"      column="item_id"     />
        <result property="inId"        column="in_id"       />
        <result property="bookId"      column="book_id"     />
        <result property="isbn"        column="isbn"        />
        <result property="title"       column="title"       />
        <result property="locationId"  column="location_id" />
        <result property="orderQty"    column="order_qty"   />
        <result property="actualQty"   column="actual_qty"  />
        <result property="diffQty"     column="diff_qty"    />
        <result property="unitCost"    column="unit_cost"   />
        <result property="amount"      column="amount"      />
        <result property="diffReason"  column="diff_reason" />
        <result property="createTime"  column="create_time" />
    </resultMap>

    <select id="selectStockInItemList" parameterType="StockInItem" resultMap="StockInItemResult">
        select t.item_id, t.in_id, t.book_id, t.isbn, t.title, t.location_id,
               t.order_qty, t.actual_qty, t.diff_qty, t.unit_cost, t.amount,
               t.diff_reason, t.create_time
        from biz_stock_in_item t
        <where>
            <if test="inId != null">
                and t.in_id = #{inId}
            </if>
            <if test="bookId != null">
                and t.book_id = #{bookId}
            </if>
            <if test="isbn != null and isbn != ''">
                and t.isbn = #{isbn}
            </if>
        </where>
        order by t.item_id asc
    </select>

    <delete id="deleteByInIds">
        delete from biz_stock_in_item where in_id in
        <foreach collection="inIds" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>
