<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tbgbook.bookstore.usedbook.mapper.RecycleItemMapper">

    <resultMap type="RecycleItem" id="RecycleItemResult">
        <result property="itemId"           column="item_id"           />
        <result property="recycleId"        column="recycle_id"        />
        <result property="isbn"             column="isbn"              />
        <result property="title"            column="title"             />
        <result property="submitGradeId"    column="submit_grade_id"   />
        <result property="submitGradeName"  column="submit_grade_name" />
        <result property="judgeGradeId"     column="judge_grade_id"    />
        <result property="judgeGradeName"   column="judge_grade_name"  />
        <result property="isMismatch"       column="is_mismatch"       />
        <result property="judgeNote"        column="judge_note"        />
        <result property="basePrice"        column="base_price"        />
        <result property="priceFactor"      column="price_factor"      />
        <result property="finalPrice"       column="final_price"       />
        <result property="itemStatus"       column="item_status"       />
        <result property="rejectReason"     column="reject_reason"     />
        <result property="usedBookId"       column="used_book_id"      />
        <result property="createTime"       column="create_time"       />
    </resultMap>

    <select id="selectRecycleItemList" parameterType="RecycleItem" resultMap="RecycleItemResult">
        select i.item_id, i.recycle_id, i.isbn, i.title, i.submit_grade_id, i.submit_grade_name,
               i.judge_grade_id, i.judge_grade_name, i.is_mismatch, i.judge_note, i.base_price,
               i.price_factor, i.final_price, i.item_status, i.reject_reason, i.used_book_id,
               i.create_time
        from biz_recycle_item i
        <where>
            <if test="recycleId != null">
                and i.recycle_id = #{recycleId}
            </if>
            <if test="isbn != null and isbn != ''">
                and i.isbn = #{isbn}
            </if>
            <if test="itemStatus != null">
                and i.item_status = #{itemStatus}
            </if>
            <if test="isMismatch != null">
                and i.is_mismatch = #{isMismatch}
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                and i.create_time &gt;= #{params.beginTime}
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                and i.create_time &lt;= #{params.endTime}
            </if>
        </where>
        order by i.item_id asc
    </select>
</mapper>
