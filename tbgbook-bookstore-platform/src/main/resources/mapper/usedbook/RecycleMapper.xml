<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tbgbook.bookstore.usedbook.mapper.RecycleMapper">

    <resultMap type="Recycle" id="RecycleResult">
        <result property="recycleId"         column="recycle_id"         />
        <result property="storeId"           column="store_id"           />
        <result property="recycleNo"         column="recycle_no"         />
        <result property="memberId"          column="member_id"          />
        <result property="memberName"        column="member_name"        />
        <result property="bookKind"          column="book_kind"          />
        <result property="totalQty"          column="total_qty"          />
        <result property="estimatedAmount"   column="estimated_amount"   />
        <result property="finalAmount"       column="final_amount"       />
        <result property="hasMismatch"       column="has_mismatch"       />
        <result property="appointmentDate"   column="appointment_date"   />
        <result property="appointmentSlot"   column="appointment_slot"   />
        <result property="settleType"        column="settle_type"        />
        <result property="settleAmount"      column="settle_amount"      />
        <result property="settleTime"        column="settle_time"        />
        <result property="status"            column="status"             />
        <result property="rejectReason"      column="reject_reason"      />
        <result property="submitTime"        column="submit_time"        />
        <result property="acceptTime"        column="accept_time"        />
        <result property="acceptBy"          column="accept_by"          />
        <result property="createBy"          column="create_by"          />
        <result property="createTime"        column="create_time"        />
        <result property="updateBy"          column="update_by"          />
        <result property="updateTime"        column="update_time"        />
        <result property="remark"            column="remark"             />
    </resultMap>

    <select id="selectRecycleList" parameterType="Recycle" resultMap="RecycleResult">
        select r.recycle_id, r.store_id, r.recycle_no, r.member_id, r.member_name, r.book_kind,
               r.total_qty, r.estimated_amount, r.final_amount, r.has_mismatch,
               r.appointment_date, r.appointment_slot, r.settle_type, r.settle_amount,
               r.settle_time, r.status, r.reject_reason, r.submit_time, r.accept_time,
               r.accept_by, r.create_by, r.create_time, r.update_by, r.update_time, r.remark
        from biz_recycle r
        <where>
            <if test="recycleNo != null and recycleNo != ''">
                and r.recycle_no = #{recycleNo}
            </if>
            <if test="memberId != null">
                and r.member_id = #{memberId}
            </if>
            <if test="status != null">
                and r.status = #{status}
            </if>
            <if test="hasMismatch != null">
                and r.has_mismatch = #{hasMismatch}
            </if>
            <if test="settleType != null">
                and r.settle_type = #{settleType}
            </if>
            <if test="params.beginAppointmentDate != null and params.beginAppointmentDate != ''">
                and r.appointment_date &gt;= #{params.beginAppointmentDate}
            </if>
            <if test="params.endAppointmentDate != null and params.endAppointmentDate != ''">
                and r.appointment_date &lt;= #{params.endAppointmentDate}
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                and r.create_time &gt;= #{params.beginTime}
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                and r.create_time &lt;= #{params.endTime}
            </if>
        </where>
        order by r.recycle_id desc
    </select>
</mapper>
